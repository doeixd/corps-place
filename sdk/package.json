{
  "name": "@corps-place/sdk",
  "version": "0.1.0",
  "description": "Effect-TS powered SDK for the DCI API with rich caching and resilience primitives.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:v10-data-control": "tsx src/buildMlSequencesV9Subcaption.ts --data-contract clean-v10 --db ./data/v10-source-2026-07-16.db --output-db ./data/v10-training-dev1.db",
    "freeze:v10-source": "tsx scripts/freezeV10Source.ts",
    "prepare:v10-data": "tsx scripts/prepareV10TrainingData.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "replay:v10-baseline": "tsx scripts/replayFinal2Baseline.ts",
    "report:v95-parity": "tsx scripts/reportV95Parity.ts",
    "report:v95-2026": "tsx scripts/reportV952026.ts",
    "test:v95-curriculum": "tsx scripts/testV95Curriculum.ts",
    "test:v95-checkpoints": "tsx scripts/testV95Checkpoints.ts",
    "test:v95-config": "tsx scripts/testV95Config.ts",
    "test:v95-evaluation": "tsx scripts/testV95Evaluation.ts",
    "test:v95-masking": "tsx scripts/testV95FeatureMasking.ts",
    "test:v95-metrics": "tsx scripts/testV95Metrics.ts",
    "test:v95-training-source": "tsx scripts/testV95TrainingSource.ts",
    "test:v10-config": "tsx scripts/testV10Config.ts",
    "test:v10-data": "tsx scripts/testV10DataContract.ts",
    "train:v10": "tsx src/training/trainModelV10Final.ts",
    "train:v95": "tsx src/training/trainModelV95.ts",
    "train:v95:final2": "tsx src/training/trainModelV95.ts --db ./dci-relational-scrape.db --reproduction-contract final2 --trial-id v95_final2_reproduction",
    "train:v95:fixed-curriculum": "bash scripts/runV95FixedCurriculum.sh",
    "train:v95:phase-aware-lr": "bash scripts/runV95PhaseAwareLr.sh",
    "train:v95:replica": "bash scripts/runV95Replica.sh",
    "train:v95:scale2x": "bash scripts/runV95Scale2xAblation.sh",
    "train:v95:scale2x-baseline-lr": "bash scripts/runV95Scale2xBaselineLrAblation.sh",
    "train:v95:smooth-sequence": "bash scripts/runV95SmoothSequence.sh",
    "snapshot:v95-training-source": "tsx scripts/snapshotV95TrainingSource.ts",
    "validate:v10-baseline": "tsx scripts/validateFinal2Baseline.ts",
    "validate:v95-architecture": "tsx scripts/validateV95Architecture.ts",
    "push:data": "tsx scripts/pushData.ts",
    "pull:data": "tsx scripts/pullData.ts",
    "pull:read-model": "tsx scripts/pullData.ts read-model"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/lib-storage": "^3.1068.0",
    "@browserbasehq/sdk": "2.14.0",
    "@doeixd/make-with": "^0.0.5",
    "@effect/platform-node": "4.0.0-beta.79",
    "@effect/sql-libsql": "4.0.0-beta.79",
    "@libsql/client": "^0.15.0",
    "@opencode-ai/sdk": "^1.17.7",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "better-sqlite3": "^12.5.0",
    "cheerio": "1.0.0-rc.12",
    "effect": "4.0.0-beta.79",
    "onnxruntime-node": "^1.23.2",
    "pdf-to-img": "^6.2.0",
    "puppeteer-core": "^24.15.0",
    "unpdf": "^1.6.2",
    "web-push": "^3.6.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  },
  "volta": {
    "node": "20.20.0"
  },
  "packageManager": "npm@11.17.0"
}
