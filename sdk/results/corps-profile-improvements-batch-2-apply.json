    {
      "corps_key": "alisal-union-school-district-marching-band",
      "name": "Alisal Union School District",
      "field": "about",
      "from": "Alisal Union School District Marching Band is a Salinas, California ensemble listed by SoundSport among its registered 2026 ensembles.",
      "to": "Alisal Union School District Marching Band is part of Alisal USD's All-Star performing arts programming in Salinas, California. The district runs student music and performance programs in partnership with FORXA Inc., offering instruction in music fundamentals, drumming, marching, marimbas and xylophones, trumpet, violin, dance, cheer, and color guard. The program appears in SoundSport as a scholastic/community ensemble connected to the district's expanded-learning arts work.",
      "source_url": "https://www.alisal.org/apps/pages/index.jsp?pREC_ID=2581808&type=d&uREC_ID=4378197"
    },
    {
