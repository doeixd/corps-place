    {
      "corps_key": "alisal-union-school-district-all-star-academy",
      "name": "Alisal Union School District All-Star Academy",
      "field": "about",
      "from": "Alisal Union School District All-Star Academy is a Salinas, California performing-arts ensemble appearing in DCI West lineups and aligned with SoundSport registered Alisal Union School District ensembles.",
      "to": "Alisal Union School District All-Star Academy is a Salinas, California performing arts program tied to Alisal USD's expanded-learning music, dance, and color guard offerings. The district describes its All-Star performance groups as student programs in music, folklorico, Aztec dance, and related arts, with music classes covering drumming, marching, mallet instruments, guitar, trumpet, violin, dance, cheer, and color guard. In SoundSport contexts, the academy functions as a scholastic showcase ensemble.",
      "source_url": "https://www.alisal.org/apps/pages/index.jsp?pREC_ID=2581808&type=d&uREC_ID=4378197"
    },
