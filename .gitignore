# WAL/SHM sidecars, and legacy single-file build.
/read-model*
/dci-relational.db
sdk/read-model*
# Generated offline JSON snapshot (emitted into the served public/ dir each ingest)
public/read-model/

# Build / generated output (rebuildable)
.output/
.tanstack/
.nitro/
.fate/

