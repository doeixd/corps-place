.deploy-status.json
.proxy-target
.proxy-*.log
.server-*.log
.tunnel-*.log
vite-smoke.*.log
tsc-output.txt
tsc-fate.log

# SDK scratch logs & debug output (one-off training/scrape artifacts)
sdk/*.log
sdk/*output*.txt
sdk/verification_results*.txt
sdk/smoke_output_*.txt
sdk/training_log_*.txt
sdk/schema*.txt
sdk/temp_*.json
sdk/test-ajax-response.json

